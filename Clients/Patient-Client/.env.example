# Serve the UI from the in-memory sample ledger in src/lib/demo.
# Set to false once Freighter signing and the Soroban client are implemented.
NEXT_PUBLIC_DEMO_MODE=true

# Base URL of the locka-api backend. Leave empty while running on sample data.
NEXT_PUBLIC_LOCKA_API_URL=

# Stellar network this client signs and submits against.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC endpoint used to simulate and submit contract invocations.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban contract IDs. Leave blank until the contracts are deployed.
NEXT_PUBLIC_PATIENT_PASSPORT_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_PROVIDER_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_MEDICAL_RECORD_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CONSENT_ACCESS_MANAGER_CONTRACT_ID=
